# app.js / data.js are only ever referenced with a ?v= stamp from index.html.
# Bump that stamp whenever either file changes.
/app.js
  Cache-Control: public, max-age=31536000, immutable
/data.js
  Cache-Control: public, max-age=31536000, immutable

# Images and icons: 30 days
/assets/*
  Cache-Control: public, max-age=2592000
/og.png
  Cache-Control: public, max-age=2592000
/icon.svg
  Cache-Control: public, max-age=2592000
